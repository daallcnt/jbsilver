	{
		$length = strlen("itms://");
		if(substr($gnu_config_gnu['linki'], 0, $length) === "itms://")
		{
			$link1 = explode("id",$gnu_config_gnu['linki']);
			$link2 = explode("?",$link1[1]);
			$gnu_config_gnu['linki'] = $link2[0];
		}
	}

	return $gnu_config_gnu;

